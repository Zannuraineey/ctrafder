# -----------------------------------------------------------------------------
# AI MULTI-MARKET TRADING INTELLIGENCE ENGINE CONFIGURATION
# -----------------------------------------------------------------------------

# APPLICATION MODE
APP_NAME=AITradingEngine
# Allowed modes: paper | demo | live (Default: paper)
TRADING_MODE=paper
LOG_LEVEL=INFO

# DATABASE
DATABASE_URL=sqlite:///data/trading_ai.db

# CTRADER OPEN API CREDENTIALS (Obtain from https://open-api.ctrader.com)
CTRADER_CLIENT_ID=your_client_id_here
CTRADER_CLIENT_SECRET=your_client_secret_here
CTRADER_ACCESS_TOKEN=your_access_token_here
CTRADER_REFRESH_TOKEN=your_refresh_token_here
CTRADER_ACCOUNT_ID=your_account_id_here
# Environment: demo | live (Default: demo)
CTRADER_ENVIRONMENT=demo
CTRADER_HOST_DEMO=demo.ctraderapi.com
CTRADER_HOST_LIVE=live.ctraderapi.com
CTRADER_PORT=5035

# RISK ENGINE (STRICT LIMITS)
# Maximum risk per trade as a fraction of account balance (e.g. 0.005 = 0.5%)
RISK_PER_TRADE=0.005
# Maximum allowable daily loss (e.g. 0.02 = 2.0%)
MAX_DAILY_LOSS=0.02
# Maximum allowable total drawdown (e.g. 0.10 = 10.0%)
MAX_DRAWDOWN=0.10
# Maximum concurrent open positions
MAX_OPEN_POSITIONS=3
# Maximum portfolio correlation limit (0.0 to 1.0)
MAX_CORRELATED_EXPOSURE=0.70
# Minimum risk/reward ratio required to approve trade
MIN_RISK_REWARD=1.5
# Maximum allowable spread in pips/points before rejection
MAX_SPREAD_PIPS=3.0

# SCANNER & TIMEFRAMES
SCAN_INTERVAL_SECONDS=1.0
MAX_MARKETS=50
DEFAULT_TIMEFRAME=1m
HIGHER_TIMEFRAME=5m
MACRO_TIMEFRAME=15m

# SCALPING TIMEOUTS & STAGNATION
TARGET_DURATION_SECONDS=60
SOFT_TIMEOUT_SECONDS=90
HARD_TIMEOUT_SECONDS=180
STAGNATION_CANDLE_COUNT=6

# AI & MACHINE LEARNING THRESHOLDS
MIN_DIRECTION_PROBABILITY=0.75
MIN_TRADE_QUALITY=0.70
MAX_WHIPSAW_PROBABILITY=0.25

# PAPER BROKER DEFAULTS
PAPER_STARTING_BALANCE=10000.0
PAPER_LEVERAGE=100.0
PAPER_SPREAD_PIPS=0.8
PAPER_SLIPPAGE_PIPS=0.2
PAPER_COMMISSION_PER_LOT=3.50
